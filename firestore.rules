rules_version = '2';

// =====================================================================
//  MÜDAVİM — Firestore güvenlik kuralları
//  Firebase konsolu > Firestore Database > Kurallar sekmesine yapıştır.
//  ADMIN mail listesini config.js'teki ile aynı tut (küçük harfle yaz).
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          "hamzazilan34@gmail.com",
          "gokbarazomerfaruk@gmail.com"
        ];
    }

    function myUserDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isApproved() {
      return signedIn() && exists(myUserDoc()) && get(myUserDoc()).data.status == "approved";
    }

    // ---- Sezonlar ve maçlar: herkes okur, sadece admin yazar ----
    match /seasons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /matches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Oyuncular ----
    match /players/{id} {
      allow read: if true;
      allow write: if isAdmin();

      // Onaylı üye kendi adıyla yeni oyuncu oluşturabilir
      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(["name", "uid", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 40;

      // Onaylı üye sahipsiz bir oyuncuyu kendine bağlayabilir
      // ya da kendine bağlı oyuncunun bağlantısını kaldırabilir
      allow update: if isApproved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uid"])
        && (
          (resource.data.get("uid", null) == null && request.resource.data.uid == request.auth.uid)
          || (resource.data.get("uid", null) == request.auth.uid && request.resource.data.uid == null)
        );
    }

    // ---- Rating (maç sonu puanlama) ----
    function docPath(c, id) {
      return /databases/$(database)/documents/$(c)/$(id);
    }

    function lockId(d) {
      return d.match + "_" + d.rater + "_" + d.target;
    }

    function validVote(d) {
      let m = get(docPath("matches", d.match)).data;
      return request.time < m.voteUntil
        && (d.rater in m.home.players || d.rater in m.away.players)
        && (d.target in m.home.players || d.target in m.away.players);
    }

    // Gizli kayıt: kim kime kaç verdi. Sadece admin ve puanı veren okur.
    match /privateVotes/{vid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(["match", "rater", "target", "score", "uid"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 1
        && request.resource.data.score <= 10
        && request.resource.data.rater != request.resource.data.target
        && get(docPath("players", request.resource.data.rater)).data.get("uid", null) == request.auth.uid
        && validVote(request.resource.data)
        && !exists(docPath("voteLocks", lockId(request.resource.data)))
        && getAfter(docPath("voteLocks", lockId(request.resource.data))).data.voteId == vid;
      allow delete: if isAdmin();
    }

    // Aynı kişiye aynı maçta ikinci kez puan verilmesini engeller
    match /voteLocks/{lid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["match", "rater", "target", "uid", "voteId"])
        && request.resource.data.uid == request.auth.uid
        && lid == lockId(request.resource.data)
        && getAfter(docPath("privateVotes", request.resource.data.voteId)).data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // İsimsiz kayıt: sadece kime kaç puan verildiği. Herkes okur.
    match /publicVotes/{vid} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["match", "target", "score"])
        && getAfter(docPath("privateVotes", vid)).data.uid == request.auth.uid
        && getAfter(docPath("privateVotes", vid)).data.match == request.resource.data.match
        && getAfter(docPath("privateVotes", vid)).data.target == request.resource.data.target
        && getAfter(docPath("privateVotes", vid)).data.score == request.resource.data.score;
      allow delete: if isAdmin();
    }

    // ---- Üyeler ----
    match /users/{uid} {
      // Herkes kendi kaydını, admin herkesi görür
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

      // Yeni kayıt her zaman "onay bekliyor" olarak açılır
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["email", "displayName", "status", "createdAt"])
        && request.resource.data.status == "pending";

      // Üye sadece görünen adını değiştirebilir
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName"]);

      // Admin her şeyi yapabilir (onay, red, silme)
      allow create, update, delete: if isAdmin();
    }
  }
}
